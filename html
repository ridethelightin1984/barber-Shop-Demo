<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Southline Barbers | Southside Oklahoma</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<style>
:root{
  --black:#0f0f12;
  --charcoal:#18181c;
  --accent:#c7a14a;
  --text:#f5f5f5;
  --muted:#b5b5b5;
}

*{margin:0;padding:0;box-sizing:border-box;}

body{
  font-family:Inter, sans-serif;
  background:var(--black);
  color:var(--text);
  line-height:1.6;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:30px;
}

/* NAV */
nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 0;
}

.logo{
  font-family:"Playfair Display", serif;
  font-size:24px;
  letter-spacing:2px;
  color:var(--accent);
}

nav a{
  color:var(--muted);
  margin-left:20px;
  text-decoration:none;
  font-weight:500;
}

nav a:hover{
  color:var(--accent);
}

/* HERO */
.hero{
  padding:100px 0;
  text-align:center;
}

.hero h1{
  font-family:"Playfair Display", serif;
  font-size:42px;
  letter-spacing:3px;
  margin-bottom:20px;
}

.hero p{
  color:var(--muted);
  max-width:600px;
  margin:auto;
  margin-bottom:30px;
}

.button{
  display:inline-block;
  padding:12px 25px;
  background:var(--accent);
  color:black;
  text-decoration:none;
  font-weight:600;
  border-radius:4px;
}

.button:hover{
  opacity:.9;
}

/* SECTION */
section{
  padding:80px 0;
}

.section-title{
  font-family:"Playfair Display", serif;
  font-size:22px;
  margin-bottom:40px;
  text-align:center;
  letter-spacing:2px;
  color:var(--accent);
}

/* SERVICES */
.services{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:25px;
}

.card{
  background:var(--charcoal);
  padding:25px;
  border-radius:8px;
  border:1px solid #222;
}

.card h3{
  margin-bottom:10px;
}

.price{
  margin-top:10px;
  color:var(--accent);
  font-weight:600;
}

/* FOOTER */
footer{
  text-align:center;
  padding:40px 0;
  border-top:1px solid #222;
  color:var(--muted);
  font-size:14px;
}

@media(max-width:768px){
  .hero h1{font-size:32px;}
}
</style>
</head>

<body>

<div class="container">

<nav>
  <div class="logo">SOUTHLINE BARBERS</div>
  <div>
    <a href="#services">Services</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<section class="hero">
  <h1>Precision Cuts. Southside Standards.</h1>
  <p>
    Modern fades. Clean tapers. Straight razor finishes.
    Proudly serving Southside Oklahoma with respect and craft.
  </p>
  <a href="#" class="button">Book Appointment</a>
</section>

<section id="services">
  <div class="section-title">Services</div>
  <div class="services">

    <div class="card">
      <h3>Taper Fade</h3>
      <p>Clean blend with sharp line-up.</p>
      <div class="price">$15</div>
    </div>

    <div class="card">
      <h3>Classic Haircut</h3>
      <p>Traditional cut with modern detail.</p>
      <div class="price">$20</div>
    </div>

    <div class="card">
      <h3>Skin Fade</h3>
      <p>Precision fade down to skin.</p>
      <div class="price">$25</div>
    </div>

    <div class="card">
      <h3>Beard Trim</h3>
      <p>Shape + razor line finish.</p>
      <div class="price">$10</div>
    </div>

    <div class="card">
      <h3>Full Service Cut + Beard</h3>
      <p>Fade + beard + razor detail.</p>
      <div class="price">$35</div>
    </div>

  </div>
</section>

<section id="contact">
  <div class="section-title">Location</div>
  <p style="text-align:center;color:var(--muted);">
    Southside Oklahoma City<br>
    Phone: (405) 555-1122<br>
    Instagram: @southlinebarbers
  </p>
</section>

<footer>
  © <span id="year"></span> Southline Barbers • All Rights Reserved
</footer>

</div>

<script>
document.getElementById("year").textContent = new Date().getFullYear();
</script>

</body>
</html>
